// ============================================================
// MageOS Enterprise Restaurant POS — data model
// Tenant hierarchy: Organization → Location → (Stations, Zones, Devices)
// All tenant data carries organizationId (directly or via Location) and
// every resolver scopes by the organization taken from the JWT.
// ============================================================
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------- Enums ----------------

enum OrgType {
  RESTAURANT
  BAKERY
  CAFE
  QUICK_SERVICE
  FINE_DINING
  CASUAL_DINING
  BAR_PUB
  FOOD_TRUCK
  CLOUD_KITCHEN
  FOOD_COURT
  CATERING
  HOTEL_RESTAURANT
}

enum OrgSize {
  SMALL
  MEDIUM
  LARGE
  ENTERPRISE
}

enum UserRole {
  OWNER
  MANAGER
  SHIFT_LEAD
  STAFF
  CUSTOMER
}

enum OrderStatus {
  OPEN
  PENDING
  IN_PROGRESS
  READY
  COMPLETED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
  PARTIALLY_REFUNDED
  REFUNDED
}

enum PaymentMethod {
  CASH
  CARD
  DIGITAL
  SPLIT
  GIFT_CARD
  LOYALTY
  HOUSE_ACCOUNT
  OTHER
}

enum PaymentType {
  SALE
  REFUND
}

enum TableStatus {
  AVAILABLE
  SEATED
  ORDERING
  WAITING_FOR_FOOD
  READY_FOR_PAYMENT
  NEEDS_CLEANING
}

enum OrderType {
  DINE_IN
  TAKEAWAY
  DELIVERY
  PICKUP
  DRIVE_THRU
  CATERING
  ROOM_SERVICE
}

enum ItemStatus {
  PENDING
  FIRED
  PREPARING
  READY
  SERVED
  VOIDED
}

enum DiscountType {
  PERCENT
  FIXED
}

enum DiscountScope {
  ORDER
  ITEM
  CATEGORY
}

enum ReservationStatus {
  BOOKED
  CONFIRMED
  WAITLIST
  SEATED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum ShiftStatus {
  OPEN
  CLOSED
}

enum CashMovementType {
  PAY_IN
  PAY_OUT
  DROP
}

enum StockMovementType {
  SALE
  PURCHASE
  WASTE
  ADJUSTMENT
  TRANSFER_IN
  TRANSFER_OUT
  COUNT
  RETURN
}

enum PurchaseOrderStatus {
  DRAFT
  SENT
  PARTIAL
  RECEIVED
  CANCELLED
}

enum DeviceType {
  POS
  KDS
  KIOSK
  PRINTER
  PAYMENT_TERMINAL
  CUSTOMER_DISPLAY
}

// ---------------- Tenant ----------------

model Organization {
  id                  String   @id @default(cuid())
  name                String   @unique
  legalName           String?
  domain              String?  @unique
  type                OrgType  @default(RESTAURANT)
  size                OrgSize  @default(SMALL)
  logoUrl             String?
  address             String?
  phone               String?
  email               String?
  taxId               String?
  taxRate             Float    @default(8.0)
  taxInclusive        Boolean  @default(false)
  country             String   @default("US")
  currency            String   @default("USD")
  locale              String   @default("en-US")
  timezone            String   @default("UTC")
  settings            Json     @default("{}")
  onboardingCompleted Boolean  @default(false)
  plan                String   @default("STARTER")
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  users          User[]
  locations      Location[]
  categories     Category[]
  products       Product[]
  orders         Order[]
  roles          Role[]
  taxRates       TaxRate[]
  modifierGroups ModifierGroup[]
  discounts      Discount[]
  customers      Customer[]
  stockItems     StockItem[]
  suppliers      Supplier[]
  purchaseOrders PurchaseOrder[]
  auditLogs      AuditLog[]

  @@index([name])
}

model Location {
  id             String   @id @default(cuid())
  code           String?
  name           String
  address        String?
  city           String?
  country        String?
  phone          String?
  email          String?
  timezone       String?
  isHeadOffice   Boolean  @default(false)
  receiptHeader  String?
  receiptFooter  String?
  settings       Json     @default("{}")
  isActive       Boolean  @default(true)
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  departments    Department[]
  users          User[]
  products       Product[]
  orders         Order[]
  inventory      Inventory[]
  floorPlanZones FloorPlanZone[]
  stations       KitchenStation[]
  devices        Device[]
  shifts         Shift[]
  timeEntries    TimeEntry[]
  reservations   Reservation[]
  stockLevels    StockLevel[]
  stockMovements StockMovement[]
  purchaseOrders PurchaseOrder[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model Department {
  id          String   @id @default(cuid())
  name        String
  description String?
  isActive    Boolean  @default(true)
  locationId  String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  location Location  @relation(fields: [locationId], references: [id], onDelete: Cascade)
  users    User[]
  products Product[]

  @@unique([locationId, name])
  @@index([locationId])
}

// ---------------- Identity & Access ----------------

model Role {
  id             String   @id @default(cuid())
  name           String
  description    String?
  permissions    String[] @default([])
  isSystem       Boolean  @default(false)
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  users        User[]

  @@unique([organizationId, name])
}

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  password       String
  pinHash        String?
  name           String
  role           UserRole  @default(STAFF)
  roleId         String?
  phone          String?
  avatarUrl      String?
  hourlyRate     Float?
  isActive       Boolean   @default(true)
  lastLoginAt    DateTime?
  organizationId String
  locationId     String?
  departmentId   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  location      Location?      @relation(fields: [locationId], references: [id])
  department    Department?    @relation(fields: [departmentId], references: [id])
  customRole    Role?          @relation(fields: [roleId], references: [id])
  orders        Order[]
  tableSessions TableSession[]
  shifts        Shift[]
  timeEntries   TimeEntry[]
  payments      Payment[]

  @@index([organizationId])
  @@index([email])
}

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  userId         String?
  userName       String?
  action         String
  entity         String
  entityId       String?
  meta           Json?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
}

model Sequence {
  key   String @id
  value Int    @default(0)
}

// ---------------- Catalog ----------------

model TaxRate {
  id             String   @id @default(cuid())
  name           String
  rate           Float
  isDefault      Boolean  @default(false)
  isActive       Boolean  @default(true)
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  products     Product[]

  @@index([organizationId])
}

model Category {
  id             String   @id @default(cuid())
  name           String
  description    String?
  color          String?
  icon           String?
  sortOrder      Int      @default(0)
  isActive       Boolean  @default(true)
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  products     Product[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model Product {
  id             String   @id @default(cuid())
  name           String
  description    String?
  sku            String?
  barcode        String?
  price          Float
  cost           Float?
  imageUrl       String?
  color          String?
  isActive       Boolean  @default(true)
  trackStock     Boolean  @default(false)
  isOpenPrice    Boolean  @default(false)
  prepMinutes    Int?
  dietary        String[] @default([])
  channels       String[] @default(["POS", "ONLINE", "KIOSK"])
  priceOverrides Json     @default("{}")
  sortOrder      Int      @default(0)
  organizationId String
  locationId     String?
  departmentId   String?
  categoryId     String?
  taxRateId      String?
  stationId      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  location       Location?              @relation(fields: [locationId], references: [id])
  department     Department?            @relation(fields: [departmentId], references: [id])
  category       Category?              @relation(fields: [categoryId], references: [id])
  taxRateRef     TaxRate?               @relation(fields: [taxRateId], references: [id])
  station        KitchenStation?        @relation(fields: [stationId], references: [id])
  orderItems     OrderItem[]
  inventory      Inventory[]
  modifierGroups ProductModifierGroup[]
  recipe         RecipeLine[]

  @@index([organizationId])
  @@index([categoryId])
}

model ModifierGroup {
  id             String   @id @default(cuid())
  name           String
  minSelect      Int      @default(0)
  maxSelect      Int      @default(1)
  isActive       Boolean  @default(true)
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  modifiers    Modifier[]
  products     ProductModifierGroup[]

  @@index([organizationId])
}

model Modifier {
  id        String  @id @default(cuid())
  name      String
  price     Float   @default(0)
  isDefault Boolean @default(false)
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)
  groupId   String

  group ModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId])
}

model ProductModifierGroup {
  productId String
  groupId   String
  sortOrder Int    @default(0)

  product Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  group   ModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([productId, groupId])
}

model Discount {
  id               String        @id @default(cuid())
  name             String
  code             String?
  type             DiscountType  @default(PERCENT)
  scope            DiscountScope @default(ORDER)
  value            Float
  minOrderAmount   Float?
  maxDiscount      Float?
  categoryId       String?
  requiresApproval Boolean       @default(false)
  autoApply        Boolean       @default(false)
  startsAt         DateTime?
  endsAt           DateTime?
  daysOfWeek       Int[]         @default([])
  startTime        String?
  endTime          String?
  usageCount       Int           @default(0)
  isActive         Boolean       @default(true)
  organizationId   String
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

// ---------------- Operations ----------------

model KitchenStation {
  id          String   @id @default(cuid())
  name        String
  color       String?
  printerName String?
  isExpo      Boolean  @default(false)
  isActive    Boolean  @default(true)
  locationId  String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  location   Location    @relation(fields: [locationId], references: [id], onDelete: Cascade)
  products   Product[]
  orderItems OrderItem[]

  @@index([locationId])
}

model Device {
  id         String     @id @default(cuid())
  name       String
  type       DeviceType @default(POS)
  identifier String?
  ipAddress  String?
  lastSeenAt DateTime?
  isActive   Boolean    @default(true)
  locationId String
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@index([locationId])
}

model Customer {
  id             String    @id @default(cuid())
  name           String
  phone          String?
  email          String?
  birthday       DateTime?
  notes          String?
  tags           String[]  @default([])
  loyaltyPoints  Int       @default(0)
  totalSpent     Float     @default(0)
  visitCount     Int       @default(0)
  lastVisitAt    DateTime?
  houseAccount   Boolean   @default(false)
  balance        Float     @default(0)
  isActive       Boolean   @default(true)
  organizationId String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  orders       Order[]
  reservations Reservation[]

  @@index([organizationId])
  @@index([phone])
}

model Inventory {
  id         String   @id @default(cuid())
  quantity   Int      @default(0)
  minStock   Int      @default(10)
  maxStock   Int?
  unit       String?  @default("unit")
  productId  String
  locationId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([productId, locationId])
  @@index([productId])
  @@index([locationId])
}

model Order {
  id             String        @id @default(cuid())
  orderNumber    String        @unique
  ticketNumber   Int?
  status         OrderStatus   @default(PENDING)
  paymentStatus  PaymentStatus @default(UNPAID)
  paymentMethod  PaymentMethod @default(CASH)
  channel        String        @default("POS")
  subtotal       Float
  taxAmount      Float         @default(0)
  discountAmount Float         @default(0)
  discountId     String?
  discountReason String?
  discountSpec   Json?
  serviceCharge  Float         @default(0)
  tipAmount      Float         @default(0)
  roundingAmount Float         @default(0)
  total          Float
  paidAmount     Float         @default(0)
  refundedAmount Float         @default(0)
  taxBreakdown   Json?
  guestCount     Int?
  notes          String?
  idempotencyKey String?       @unique
  organizationId String
  locationId     String
  userId         String?
  customerId     String?
  tableId        String?
  shiftId        String?
  orderType      OrderType     @default(DINE_IN)
  tableSessionId String?
  completedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  location     Location      @relation(fields: [locationId], references: [id])
  user         User?         @relation(fields: [userId], references: [id])
  customer     Customer?     @relation(fields: [customerId], references: [id])
  tableSession TableSession? @relation(fields: [tableSessionId], references: [id])
  shift        Shift?        @relation(fields: [shiftId], references: [id])
  items        OrderItem[]
  payments     Payment[]

  @@index([organizationId])
  @@index([locationId])
  @@index([createdAt])
  @@index([status])
}

model OrderItem {
  id         String     @id @default(cuid())
  name       String?
  quantity   Int
  price      Float
  subtotal   Float
  taxRate    Float      @default(0)
  taxAmount  Float      @default(0)
  discount   Float      @default(0)
  modifiers  Json?
  notes      String?
  seat       Int?
  course     Int        @default(1)
  status     ItemStatus @default(PENDING)
  voidReason String?
  firedAt    DateTime?
  readyAt    DateTime?
  stationId  String?
  orderId    String
  productId  String
  createdAt  DateTime   @default(now())

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id])
  station KitchenStation? @relation(fields: [stationId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@index([stationId, status])
}

model Payment {
  id        String        @id @default(cuid())
  type      PaymentType   @default(SALE)
  method    PaymentMethod
  amount    Float
  tip       Float         @default(0)
  tendered  Float?
  change    Float?
  reference String?
  reason    String?
  orderId   String
  userId    String?
  shiftId   String?
  createdAt DateTime      @default(now())

  order Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user  User?  @relation(fields: [userId], references: [id])
  shift Shift? @relation(fields: [shiftId], references: [id])

  @@index([orderId])
  @@index([shiftId])
}

model Shift {
  id           String      @id @default(cuid())
  status       ShiftStatus @default(OPEN)
  openingFloat Float       @default(0)
  closingCash  Float?
  expectedCash Float?
  variance     Float?
  notes        String?
  openedAt     DateTime    @default(now())
  closedAt     DateTime?
  userId       String
  locationId   String

  user          User           @relation(fields: [userId], references: [id])
  location      Location       @relation(fields: [locationId], references: [id], onDelete: Cascade)
  orders        Order[]
  payments      Payment[]
  cashMovements CashMovement[]

  @@index([locationId, status])
}

model CashMovement {
  id        String           @id @default(cuid())
  type      CashMovementType
  amount    Float
  reason    String?
  shiftId   String
  userId    String?
  createdAt DateTime         @default(now())

  shift Shift @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  @@index([shiftId])
}

model TimeEntry {
  id           String    @id @default(cuid())
  clockIn      DateTime  @default(now())
  clockOut     DateTime?
  breakMinutes Int       @default(0)
  userId       String
  locationId   String

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@index([userId, clockIn])
}

model Reservation {
  id            String            @id @default(cuid())
  customerName  String
  phone         String?
  email         String?
  partySize     Int
  dateTime      DateTime
  durationMin   Int               @default(90)
  quotedWaitMin Int?
  status        ReservationStatus @default(BOOKED)
  notes         String?
  tableId       String?
  customerId    String?
  locationId    String
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  location Location  @relation(fields: [locationId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id])

  @@index([locationId, dateTime])
}

// ---------------- Floor plan ----------------

model FloorPlanZone {
  id         String   @id @default(cuid())
  name       String
  locationId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  tables   Table[]

  @@index([locationId])
}

model Table {
  id        String      @id @default(cuid())
  name      String
  capacity  Int
  shape     String // "ROUND" | "RECTANGLE"
  x         Int
  y         Int
  width     Int
  height    Int
  status    TableStatus @default(AVAILABLE)
  zoneId    String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  zone     FloorPlanZone  @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  sessions TableSession[]

  @@index([zoneId])
}

model TableSession {
  id           String    @id @default(cuid())
  guestCount   Int
  startTime    DateTime  @default(now())
  endTime      DateTime?
  tableId      String
  serverUserId String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  table  Table   @relation(fields: [tableId], references: [id], onDelete: Cascade)
  server User?   @relation(fields: [serverUserId], references: [id])
  orders Order[]

  @@index([tableId])
  @@index([serverUserId])
}

// ---------------- Inventory (ingredients / back of house) ----------------

model StockItem {
  id             String   @id @default(cuid())
  name           String
  sku            String?
  unit           String   @default("kg")
  category       String?
  costPerUnit    Float    @default(0)
  isActive       Boolean  @default(true)
  supplierId     String?
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplier     Supplier?           @relation(fields: [supplierId], references: [id])
  levels       StockLevel[]
  movements    StockMovement[]
  recipeLines  RecipeLine[]
  poLines      PurchaseOrderLine[]

  @@unique([organizationId, name])
}

model StockLevel {
  id           String   @id @default(cuid())
  quantity     Float    @default(0)
  parLevel     Float    @default(0)
  reorderPoint Float    @default(0)
  stockItemId  String
  locationId   String
  updatedAt    DateTime @updatedAt

  stockItem StockItem @relation(fields: [stockItemId], references: [id], onDelete: Cascade)
  location  Location  @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([stockItemId, locationId])
}

model StockMovement {
  id          String            @id @default(cuid())
  type        StockMovementType
  quantity    Float
  unitCost    Float?
  reason      String?
  reference   String?
  stockItemId String
  locationId  String
  userId      String?
  createdAt   DateTime          @default(now())

  stockItem StockItem @relation(fields: [stockItemId], references: [id], onDelete: Cascade)
  location  Location  @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@index([stockItemId, createdAt])
  @@index([locationId, createdAt])
}

model RecipeLine {
  id          String @id @default(cuid())
  quantity    Float
  productId   String
  stockItemId String

  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  stockItem StockItem @relation(fields: [stockItemId], references: [id], onDelete: Cascade)

  @@unique([productId, stockItemId])
}

model Supplier {
  id             String   @id @default(cuid())
  name           String
  contactName    String?
  phone          String?
  email          String?
  address        String?
  leadTimeDays   Int      @default(2)
  paymentTerms   String?
  isActive       Boolean  @default(true)
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stockItems     StockItem[]
  purchaseOrders PurchaseOrder[]

  @@index([organizationId])
}

model PurchaseOrder {
  id             String              @id @default(cuid())
  number         String              @unique
  status         PurchaseOrderStatus @default(DRAFT)
  total          Float               @default(0)
  notes          String?
  expectedAt     DateTime?
  receivedAt     DateTime?
  supplierId     String
  locationId     String
  organizationId String
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  supplier     Supplier            @relation(fields: [supplierId], references: [id])
  location     Location            @relation(fields: [locationId], references: [id], onDelete: Cascade)
  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lines        PurchaseOrderLine[]

  @@index([organizationId])
}

model PurchaseOrderLine {
  id              String @id @default(cuid())
  quantity        Float
  receivedQty     Float  @default(0)
  unitCost        Float
  purchaseOrderId String
  stockItemId     String

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  stockItem     StockItem     @relation(fields: [stockItemId], references: [id])
}
